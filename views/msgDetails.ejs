<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css-reset.css">
    <link rel="stylesheet" href="/styles.css">
    <title>Odin Mini Message Board</title>
</head>
<body>
    <%- include('components/header') %>
    <main>
        <h2>Message Details</h2>
        <div class="deets-wrapper">
            <div>
                <h3>Username</h3>
                <p><%= message.made_by %></p>
            </div>
            <div>
                <h4>Date sent</h4>
                <p><%= message.date_added %></p>
            </div>
            <div>
                <h4>Message</h4>
                <p><%= message.text %></p>
            </div>
        </div>
    </main>
</body>
</html>